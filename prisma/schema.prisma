datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String   @id @default(cuid())
  clerkId             String   @unique
  email               String   @unique
  fullName            String?
  role                String   @default("STUDENT") // "STUDENT" | "FACULTY" | "ADMIN"
  isMasterAdmin       Boolean  @default(false)
  requestedRole       String?  // "FACULTY" | "ADMIN" | null when awaiting approval
  approvalStatus      String   @default("APPROVED") // "APPROVED" | "PENDING" | "REJECTED"
  employeeId          String?  // Faculty/Admin employee ID
  designation         String?  // e.g. "Assistant Professor", "HOD", "Dean Academics", "Master Admin"
  department          String?  // SETGOI department: "CSE" | "CSE-AIML" | "CSE-DS" | "ECE" | "EE" | "EEE" | "ME" | "CE"
  degree              String   @default("B.Tech")  // strictly B.Tech
  branch              String?  // "CSE" | "ECE" | "EE" | "ME" | "CE" | "IT" | "AIML"
  semester            Int?     // 1 to 8
  passoutYear         Int?     // e.g. 2026–2030
  universityRoll      String?  // optional MAKAUT roll number
  onboardingCompleted Boolean  @default(false)
  requestedScopes     Json?    // e.g. [{ "branch": "CSE", "semesters": [3, 5] }]
  assignedScopes      Json?    // e.g. [{ "branch": "CSE", "semesters": [3] }]
  onboardingNote      String?  @db.Text
  academicStats       Json?    // { cgpa, attendancePct, attendedClasses, totalClasses, semesterSgpas }
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  notes        Note[]
  forumPosts   ForumPost[]
  forumReplies ForumReply[]
  vivaSessions      VivaSession[]
  notices           Notice[]
  attendanceRecords AttendanceRecord[]

  @@index([clerkId])
  @@index([email])
  @@index([branch, semester])
}

model Note {
  id          String   @id @default(cuid())
  title       String
  subjectCode String   // e.g. "PCC-CS301", "ESC301"
  subjectName String?
  branch      String   // e.g. "CSE"
  semester    Int      // 1 to 8
  fileUrl     String
  fileKey     String
  fileSize    Int?     @default(0)
  category    String   @default("LECTURE_NOTE") // "LECTURE_NOTE" | "MAKAUT_PYQ" | "LAB_MANUAL"
  content     String?  @db.Text
  verified    Boolean  @default(false)
  isVerified  Boolean  @default(false)
  authorName  String?
  authorRole  String?
  verifiedBy  String?
  
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subjectCode])
  @@index([branch, semester])
  @@index([verified])
  @@index([uploaderId])
}

model ForumPost {
  id        String       @id @default(cuid())
  title     String
  content   String       @db.Text
  tags      String?      // comma-separated tags or json
  category  String?      @default("Academic")
  branch     String?      // optional branch targeting e.g. "CSE"
  semester   Int?         // optional semester e.g. 3
  upvotes    Int          @default(0)
  isResolved Boolean      @default(false)
  isPinned   Boolean      @default(false)
  isLocked   Boolean      @default(false)
  
  authorId   String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  replies   ForumReply[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([category])
  @@index([branch, semester])
  @@index([createdAt])
  @@index([authorId])
}

model ForumReply {
  id               String       @id @default(cuid())
  content          String       @db.Text
  postId           String
  post             ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId         String
  author           User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isOfficialAnswer  Boolean      @default(false)
  isVerifiedFaculty Boolean      @default(false)
  facultyName       String?
  upvotes           Int          @default(0)
  parentId         String?
  parent           ForumReply?  @relation("NestedReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children         ForumReply[] @relation("NestedReplies")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([postId])
  @@index([authorId])
}

model VivaSession {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        String        // e.g. "DSA", "COA", "OS"
  subjectCode    String?       // e.g. "PCC-CS301"
  subjectName    String?       // e.g. "Data Structures & Algorithms"
  branch         String?       // e.g. "CSE"
  semester       Int?          // e.g. 3
  title          String?       // e.g. "PCC-CS301 • Data Structures & Algorithms"
  language       String        @default("en") // "en" | "hi"
  score          Int?          @default(0)
  totalQuestions Int?          @default(0)
  weakTopics     String?       @db.Text // JSON or comma-separated weak topics
  messages       VivaMessage[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([subject])
  @@index([subjectCode])
  @@index([updatedAt])
  @@index([createdAt])
}

model VivaMessage {
  id           String      @id @default(cuid())
  sessionId    String
  session      VivaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String      // "user" | "assistant"
  content      String      @db.Text
  reaction     String?     @db.Text
  explanation  String?     @db.Text
  nextQuestion String?     @db.Text
  spokenText   String?     @db.Text
  emotion      String?     @default("idle") // "idle" | "happy" | "shocked" | "thinking"
  isCorrect    Boolean?
  score        Int?
  feedback     String?     @db.Text
  topicTag     String?
  provider     String?
  createdAt    DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model CampusFacility {
  id           String   @id @default(cuid())
  category     String   // "department", "hostel", "bus", "emergency", "zone"
  name         String
  building     String?
  description  String   @db.Text
  inCharge     String?
  contactPhone String?
  contactEmail String?
  meta         Json?
  createdAt    DateTime @default(now())
}

model UserProfile {
  id            String       @id // Clerk User ID (e.g. user_2...)
  email         String       @unique
  fullName      String
  role          String       @default("student")
  studentId     String?      // e.g. "SH2026001"
  department    String?      // e.g. "CSE", "ECE"
  semester      Int?         // 1 to 8
  avatarUrl     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  notesUploaded NoteItem[]   @relation("UserNotes")
  notesVerified NoteItem[]   @relation("VerifierNotes")

  @@index([role])
  @@index([department])
}

model NoteItem {
  id              String       @id @default(cuid())
  title           String
  subjectCode     String       // e.g. "PCC-CS301", "ESC301"
  subjectName     String
  department      String       // e.g. "CSE"
  semester        Int          // 1-8
  category        String       @default("LECTURE_NOTE")
  academicYear    String       // e.g. "2026-2027"
  fileUrl         String
  fileSize        Int          // in bytes
  downloadsCount  Int          @default(0)
  status          String       @default("pending") // "pending" | "approved" | "rejected"
  
  uploaderId      String
  uploader        UserProfile  @relation("UserNotes", fields: [uploaderId], references: [id], onDelete: Cascade)
  
  verifiedById    String?
  verifiedBy      UserProfile? @relation("VerifierNotes", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([subjectCode])
  @@index([department, semester])
  @@index([status])
}

model Notice {
  id                String    @id @default(cuid())
  title             String
  content           String    @db.Text
  category          String    @default("ACADEMIC") // "EXAM" | "LAB_VIVA" | "ASSIGNMENT" | "ACADEMIC" | "URGENT"
  subjectCode       String?
  subjectName       String?
  targetBranch      String    @default("ALL")      // legacy single-branch field kept for compatibility
  targetSemester    Int?
  targetBranches    String[]  @default(["ALL"])
  targetSemesters   Int[]     @default([])
  examDate          DateTime?
  eventDate         DateTime?
  isPinned          Boolean   @default(false)
  authorId          String
  authorName        String?
  authorRole        String?   // "FACULTY" | "ADMIN"
  authorDesignation String?
  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([category])
  @@index([targetBranch])
  @@index([subjectCode])
  @@index([isPinned])
  @@index([createdAt])
}

model RateLimit {
  id      String   @id @default(cuid())
  key     String   @unique // e.g. "userId:viva" or "ip:viva"
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actor       String
  actorEmail  String?
  actorRole   String?
  action      String   // e.g. "ROLE_CHANGE", "NOTICE_PUBLISHED", "NOTE_VERIFIED", "FORUM_MODERATED", "DIRECTORY_UPDATED"
  target      String
  targetType  String?
  targetLabel String?
  details     String   @db.Text
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model CampusEvent {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("TECHFEST") // "TECHFEST" | "WORKSHOP" | "SEMINAR" | "CULTURAL"
  dateLabel   String
  venue       String
  description String   @db.Text
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isFeatured])
  @@index([createdAt])
}

model VivaCuratedTopic {
  id           String   @id @default(cuid())
  subjectCode  String   // e.g. "PCC-CS301"
  subjectName  String
  branch       String   @default("CSE")
  semester     Int      @default(3)
  topicTitle   String
  keyConcepts  String   @db.Text
  sampleVivaQ  String   @db.Text
  authorId     String
  authorName   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([subjectCode])
  @@index([branch, semester])
}

model ForumVote {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  replyId   String?
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, replyId])
  @@index([postId])
  @@index([replyId])
}

model CourseLecture {
  id          String   @id @default(cuid())
  title       String
  subjectCode String
  subjectName String
  branch      String
  semester    Int
  platform    String   @default("NPTEL") // "SWAYAM" | "NPTEL" | "YOUTUBE"
  courseUrl   String
  instructor  String?
  institute   String?
  duration    String?
  verified    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branch, semester])
  @@index([subjectCode])
}

model SyllabusSubject {
  id        String   @id @default(cuid())
  code      String
  name      String
  branch    String   // "CSE" | "CSE-AIML" | "CSE-DS" | "ECE" | "EE" | "EEE" | "ME" | "CE"
  semester  Int      // 1 to 8
  credits   Float    @default(3)
  category  String   @default("PCC")
  type      String   @default("THEORY") // "THEORY" | "LAB" | "SESSIONAL" | "ELECTIVE" | "MANDATORY"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branch, semester, code, name])
  @@index([branch, semester, isActive])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectCode String
  subjectName String
  branch      String   @default("CSE")
  semester    Int      @default(3)
  attended    Int      @default(0)
  total       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, subjectCode])
  @@index([userId, branch, semester])
}

model CustomVivaQuestion {
  id                String   @id @default(cuid())
  branch            String
  semester          Int
  subjectCode       String
  question          String   @db.Text
  expectedKeyPoints String   @db.Text
  createdBy         String
  createdAt         DateTime @default(now())

  @@index([branch, semester])
  @@index([subjectCode])
}
