# ==========================================
# SanakaHub - Environment Variables Reference
# ==========================================

# Clerk Authentication & RBAC
# Obtain these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Super Admin Email Whitelist (comma-separated, case-insensitive)
# Users with these emails are automatically promoted to 'admin' role
SUPER_ADMIN_EMAILS=mail@ceimran.in

# Database (PostgreSQL / Supabase / Neon connection string)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sanakahub?schema=public"

# Google Gemini API Key for Streaming Campus & Study Companion (Fallback for Viva Buddy)
# Obtain from https://aistudio.google.com
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API Key for Ultra-Low Latency Expressive AI Viva Buddy (Primary)
# Obtain from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
