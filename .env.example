# ==============================================================================
# SETTech - ENVIRONMENT VARIABLES REFERENCE / TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local (cp .env.example .env.local)
# 2. Fill in your real API credentials and database connection strings.
# 3. For Vercel / Cloud deployments, enter variables from SECTION 1 as "Secret"
#    and variables from SECTION 2 as "Plaintext / Config".
# ==============================================================================


# ==============================================================================
# SECTION 1: SECRET (Sensitive — select "Secret" in Vercel / Neon / Cloud Provider)
# ==============================================================================

# Database Connection Strings (Neon PostgreSQL / pooled & direct)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-5.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.c-5.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.c-5.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Clerk Authentication & Webhook Verification
# Obtain from: https://dashboard.clerk.com -> API Keys & Webhooks
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI Inference Keys
# Google Gemini: https://aistudio.google.com
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Groq Cloud: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Neon Object Storage (S3-compatible) Credentials
# Generated via `neon init` or Neon Console -> Object Storage
AWS_ACCESS_KEY_ID=nak_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=nsk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Fallback AI Keys (Uncomment if using DeepSeek or Sarvam TTS)
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SARVAM_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ==============================================================================
# SECTION 2: CONFIG (Non-sensitive — select "Plaintext / Config" in Dashboards)
# ==============================================================================

# Clerk Public Keys & Redirect Routes
# Obtain Publishable Key from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth-callback
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth-callback
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth-callback
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth-callback

# Canonical App URL (Used for SEO, Open Graph & metadata base)
# In production on Vercel, set to your custom domain: e.g. https://settech.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Access Control Whitelist (Comma-separated admin emails promoted to 'ADMIN' role)
SUPER_ADMIN_EMAILS=mail@ceimran.in,mdimransps955@gmail.com,principal@setgoi.ac.in

# Neon Object Storage Configuration & Endpoints
NEON_STORAGE_BUCKET=settech-notes
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-5.aws.neon.tech
AWS_REGION=ap-southeast-1

# Neon Project Infrastructure Metadata
NEON_BRANCH=production
NEON_BRANCH_ID=br-xxxx
NEON_FUNCTION_HOST_SUFFIX=.compute.c-5.aws.neon.tech
